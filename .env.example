# ---------- Développement local ----------
# SQLite : aucun serveur a installer, le fichier est cree tout seul.
DATABASE_URL="file:./dev.db"
PORT=3000
MAX_UPLOAD_MB=40

# Cle Anthropic : active la recherche assistee, la lecture des fiches et
# l'assistant. Elle reste cote serveur, jamais exposee au navigateur.
# Sans elle, ces trois fonctions sont simplement indisponibles.
ANTHROPIC_API_KEY=""

# ---------- Déploiement Netlify ----------
# Netlify ne garde aucun fichier entre deux appels : SQLite n'y survit pas.
# Il faut une base hebergee. Exemple avec Neon (offre gratuite) :
#   npm run use:postgres
#   DATABASE_URL="postgresql://user:mdp@ep-xxx.eu-central-1.aws.neon.tech/3dea?sslmode=require"
